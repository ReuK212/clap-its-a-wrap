#!/usr/bin/env node
/**
 * CLAP: Claude + Local Anthropic Proxy (Pure Node.js Implementation)
 * 
 * A smart wrapper that manages the cognition-claude-proxy lifecycle and executes claude.
 * 
 * Priority order:
 *   1. --proxy flag (explicit path to proxy directory)
 *   2. --update flag (force download from GitHub)
 *   3. Cached proxy (~/.clap/cognition-claude-proxy/)
 *   4. Bundled proxy (included with this package)
 *
 * `clap --routes` prints the model routing of the running proxy and exits.
 * `clap --setup-models` asks which upstream models are allowed and where blocked
 * requests go, saves it to ~/.clap/models.json and restarts the proxy.
 * `clap --doctor` checks Node, claude, git and the API key, and offers to
 * install or update claude.
 */

import { spawn, execSync } from 'child_process';
import readline from 'readline';
import fs from 'fs';
import os from 'os';
import path from 'path';
import { fileURLToPath } from 'url';

const HOME = os.homedir();
const PKG_DIR = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
const BUNDLED_PROXY = path.join(PKG_DIR, 'lib', 'proxy');
const DEFAULT_CACHE_DIR = path.join(HOME, '.clap');
const PROXY_GITHUB = 'https://github.com/coderexpert123/cognition-claude-proxy.git';
const DEFAULT_PORT = 8765;
// Claude Code sizes auto-compact for the Claude model it asked for (1M for
// claude-opus-5-5), but routed requests land on SWE-2 (262K). This caps the
// window; models with a smaller one (haiku: 200K) keep theirs.
const ROUTED_COMPACT_WINDOW = '262000';

// Parse command line arguments
function parseArgs() {
    const args = process.argv.slice(2);
    const result = { proxy: null, update: false, routes: false, setupModels: false, doctor: false, claudeArgs: [] };
    
    let i = 0;
    while (i < args.length) {
        const arg = args[i];
        if (arg === '--proxy') {
            if (i + 1 < args.length) {
                result.proxy = args[i + 1];
                i += 2;
            } else {
                console.error('Error: --proxy requires a path argument');
                process.exit(1);
            }
        } else if (arg === '--setup-models') {
            result.setupModels = true;
            i += 1;
        } else if (arg === '--doctor') {
            result.doctor = true;
            i += 1;
        } else if (arg === '--routes') {
            result.routes = true;
            i += 1;
        } else if (arg === '--update') {
            result.update = true;
            i += 1;
        } else {
            result.claudeArgs.push(arg);
            i += 1;
        }
    }
    return result;
}

// Get cache directory from environment or use default
function getCacheDir() {
    return process.env.CLAP_CACHE_DIR || DEFAULT_CACHE_DIR;
}

// Allowlist written by `clap --setup-models`, read by the proxy at startup
function getPolicyFile() {
    return process.env.CCP_POLICY_FILE || path.join(getCacheDir(), 'models.json');
}

// Resolve proxy directory based on priority
function resolveProxyDir() {
    const { proxy, update } = parseArgs();
    
    // 1. Explicit --proxy path (highest priority)
    if (proxy) {
        const testPath = path.join(proxy, 'src', 'server.js');
        if (fs.existsSync(testPath)) {
            return proxy;
        }
        console.error(`Error: Proxy path does not exist or is invalid: ${proxy}`);
        console.error('  Expected to find src/server.js in the directory.');
        process.exit(1);
    }
    
    // 2. --update flag: force download
    if (update) {
        return downloadProxy();
    }
    
    // 3. Cached proxy
    const cacheDir = getCacheDir();
    const cachedProxy = path.join(cacheDir, 'cognition-claude-proxy');
    if (fs.existsSync(path.join(cachedProxy, 'src', 'server.js'))) {
        return cachedProxy;
    }
    
    // 4. Bundled proxy (default)
    if (fs.existsSync(path.join(BUNDLED_PROXY, 'src', 'server.js'))) {
        return BUNDLED_PROXY;
    }
    
    console.error('Error: No proxy found.');
    console.error('  Use --update to download from GitHub, or --proxy to specify a path.');
    process.exit(1);
}

// Download proxy from GitHub
function downloadProxy() {
    const cacheDir = getCacheDir();
    const targetDir = path.join(cacheDir, 'cognition-claude-proxy');
    
    // Ensure cache directory exists
    if (!fs.existsSync(cacheDir)) {
        fs.mkdirSync(cacheDir, { recursive: true });
    }
    
    // Remove existing directory if present
    if (fs.existsSync(targetDir)) {
        rmSync(targetDir, { recursive: true, force: true });
    }
    
    console.log('Downloading cognition-claude-proxy...');
    
    try {
        execSync(`git clone --depth 1 ${PROXY_GITHUB} ${targetDir}`, { 
            stdio: 'inherit',
            cwd: cacheDir
        });
    } catch (error) {
        console.error('Error: Failed to clone proxy repository.');
        console.error(error.message);
        process.exit(1);
    }
    
    // Verify download
    if (!fs.existsSync(path.join(targetDir, 'src', 'server.js'))) {
        console.error('Error: Downloaded proxy is incomplete.');
        process.exit(1);
    }
    
    console.log(`Proxy downloaded to ${targetDir}`);
    return targetDir;
}

// Recursive directory removal (Node.js doesn't have rm -rf by default)
function rmSync(dirPath, options) {
    if (fs.existsSync(dirPath)) {
        fs.readdirSync(dirPath).forEach((file) => {
            const fullPath = path.join(dirPath, file);
            if (fs.lstatSync(fullPath).isDirectory()) {
                rmSync(fullPath, options);
            } else {
                fs.unlinkSync(fullPath);
            }
        });
        fs.rmdirSync(dirPath);
    }
}

// Check if a port is in use
function isPortInUse(port) {
    try {
        // This is a simple check - on Unix: lsof, on Windows: netstat
        if (process.platform === 'win32') {
            const output = execSync(`netstat -ano | findstr LISTENING | findstr :${port} `, { encoding: 'utf8' });
            return output.trim() !== '';
        } else {
            const output = execSync(`lsof -i :${port} -P -n | grep LISTEN`, { encoding: 'utf8', stdio: ['pipe', 'pipe', 'ignore'] });
            return output.trim() !== '';
        }
    } catch (error) {
        return false;
    }
}

// Check if proxy is healthy
async function isProxyHealthy(port) {
    try {
        const res = await fetch(`http://127.0.0.1:${port}/health`, { signal: AbortSignal.timeout(1000) });
        return res.ok;
    } catch {
        return false;
    }
}

// Start the proxy
async function startProxy(proxyDir, port) {
    const serverScript = path.join(proxyDir, 'src', 'server.js');
    const logFile = path.join(getCacheDir(), 'proxy.log');
    
    // Check if already running and healthy
    if (await isProxyHealthy(port)) {
        console.log(`Reusing healthy proxy on port ${port}`);
        return true;
    }
    
    // Check for port conflict
    if (isPortInUse(port)) {
        console.error(`Port ${port} is already in use but not by a healthy proxy.`);
        console.error('Refusing to kill the existing process.');
        process.exit(1);
    }
    
    // Start the proxy
    console.log(`Starting proxy on port ${port}...`);
    
    // Hand the log file to the child directly (not via pipes) so the proxy
    // outlives clap and clap can exit when claude does.
    fs.mkdirSync(path.dirname(logFile), { recursive: true });
    const logFd = fs.openSync(logFile, 'a');
    const proc = spawn(process.execPath, [serverScript], {
        cwd: proxyDir,
        detached: true,
        stdio: ['ignore', logFd, logFd]
    });
    fs.closeSync(logFd);
    proc.unref();

    // Wait for proxy to become healthy (up to 5 seconds)
    for (let i = 0; i < 50; i++) {
        try {
            // Check if process is still running
            if (proc.exitCode !== null) {
                console.error(`Proxy exited before becoming ready. Check ${logFile}`);
                process.exit(1);
            }
            
            // Check if healthy
            if (await isProxyHealthy(port)) {
                console.log(`Proxy started successfully on port ${port}`);
                return true;
            }
        } catch (error) {
            // Ignore and retry
        }
        
        // Wait 100ms
        await new Promise(resolve => setTimeout(resolve, 100));
    }
    
    console.error(`Proxy did not become ready within 5 seconds. Check ${logFile}`);
    process.exit(1);
}

// Print the routes the running proxy actually uses (GET /routes)
async function showRoutes(port) {
    let info;
    try {
        const res = await fetch(`http://127.0.0.1:${port}/routes`, { signal: AbortSignal.timeout(2000) });
        if (!res.ok) throw new Error(`HTTP ${res.status} (proxy predates /routes? restart it)`);
        info = await res.json();
    } catch (error) {
        console.error(`No routing info from a proxy on port ${port}: ${error.cause?.code || error.message}`);
        console.error('Start one with `clap`, or point at another with CCP_PORT.');
        process.exit(1);
    }

    const table = (rows) => {
        const w0 = Math.max(...rows.map((r) => r[0].length));
        const w1 = Math.max(...rows.map((r) => r[1].length));
        for (const [from, to, note] of rows)
            console.log(`  ${from.padEnd(w0)}  ->  ${note ? `${to.padEnd(w1)}  ${note}` : to}`);
    };

    console.log(`Proxy on 127.0.0.1:${port}, routing ${info.enabled ? 'on' : 'off'}`);
    if (info.enabled) {
        console.log('\nRoutes (exact id beats glob, longest glob wins, unmatched ids pass through):');
        table(Object.entries(info.routes).map(([from, to]) => [from, to || '(pass through)']));
    }
    if (info.allowed?.length) {
        console.log(`\nAllowed upstream models: ${info.allowed.join(', ')}`);
        console.log(`Blocked models go to: ${info.reroute_blocked_to ?? '(rejected with an error)'}`);
    } else {
        console.log('\nAllowed upstream models: all (set up a list with clap --setup-models)');
    }
    console.log(`\nRequests without a model use: ${info.default_model}`);
    console.log(`Answers start with [model: ...]: ${info.show_model ? 'yes' : 'no'} (CCP_SHOW_MODEL)`);
    console.log('\nSeen since proxy start:');
    if (info.seen.length) {
        table(info.seen.map((s) => [
            s.requested,
            s.blocked ? (s.upstream ?? '(rejected)') : s.upstream === s.requested ? '(pass through)' : s.upstream,
            `${s.count} request${s.count === 1 ? '' : 's'}${s.blocked ? `  [blocked: ${s.blocked}]` : ''}`,
        ]));
    } else {
        console.log('  (no requests yet)');
    }
}

// Main function
async function main() {
    const args = parseArgs();
    const port = parseInt(process.env.CCP_PORT || process.env.PROXY_PORT || DEFAULT_PORT, 10);
    process.env.CCP_PORT = port.toString();

    if (args.routes) {
        await showRoutes(port);
        return;
    }
    
    loadEnv();
    if (args.doctor) {
        process.exitCode = await doctor();
        return;
    }
    if (args.setupModels) {
        await setupModels(port);
        return;
    }

    // Resolve and start proxy
    const proxyDir = resolveProxyDir();
    await startProxy(proxyDir, port);
    
    // Set Anthropic base URL
    process.env.ANTHROPIC_BASE_URL = `http://127.0.0.1:${port}`; // SDK appends /v1/messages
    if (!process.env.CLAUDE_CODE_AUTO_COMPACT_WINDOW && !/^(off|0|false)$/i.test(process.env.CCP_ROUTING || '')) {
        process.env.CLAUDE_CODE_AUTO_COMPACT_WINDOW = ROUTED_COMPACT_WINDOW;
    }
    
    // Execute claude with remaining arguments
    const claude = spawn('claude', args.claudeArgs, { stdio: 'inherit' });
    claude.on('error', (error) => {
        if (error.code === 'ENOENT') {
            console.error('Error: the claude command was not found. Run `clap --doctor` to install it.');
            process.exit(1);
        }
        console.error(`Error: failed to launch claude: ${error.message}`);
        process.exit(1);
    });
    claude.on('exit', (code, signal) => process.exit(signal ? 1 : code ?? 0));
}

// Load API keys from .env.global (if present) and point the proxy at the allowlist
function loadEnv() {
    const workspaceDir = process.env.CLAP_WORKSPACE || path.join(HOME, 'repos', '_ai_workspace');
    const envFile = path.join(workspaceDir, '.env.global');
    if (fs.existsSync(envFile)) {
        const envContent = fs.readFileSync(envFile, 'utf8');
        const lines = envContent.split('\n');
        for (const line of lines) {
            const match = line.match(/^([^=]+)=(.+)$/);
            if (match) {
                const key = match[1].trim();
                let value = match[2].trim();
                // Remove quotes if present
                if ((value.startsWith('"') && value.endsWith('"')) || 
                    (value.startsWith("'") && value.endsWith("'"))) {
                    value = value.slice(1, -1);
                }
                process.env[key] = value;
            }
        }
    }
    
    // If CCP_API_KEY not set but COGNITION_API_KEY is, use it
    if (!process.env.CCP_API_KEY && process.env.COGNITION_API_KEY) {
        process.env.CCP_API_KEY = process.env.COGNITION_API_KEY;
    }
    process.env.CCP_POLICY_FILE = getPolicyFile();
}

// ---- clap --setup-models ----

const globRe = (g) => new RegExp(`^${g.split('*').map((p) => p.replace(/[.+?^${}()|[\]\\]/g, '\\$&')).join('.*')}$`);

// Line-queue prompt: works on a TTY and with piped answers (one per line).
// EOF answers every remaining question with its default.
function createPrompter() {
    const rl = readline.createInterface({ input: process.stdin, terminal: false });
    const lines = [];
    const waiting = [];
    let closed = false;
    rl.on('line', (l) => {
        if (!waiting.length) return lines.push(l);
        if (!process.stdin.isTTY) process.stdout.write(`${l}\n`); // a terminal echoes by itself
        waiting.shift()(l);
    });
    rl.on('close', () => { closed = true; while (waiting.length) waiting.shift()(null); });
    return {
        ask(question) {
            process.stdout.write(question);
            if (lines.length) { const l = lines.shift(); process.stdout.write(`${l}\n`); return Promise.resolve(l); }
            if (closed) { process.stdout.write('\n'); return Promise.resolve(null); }
            return new Promise((resolve) => waiting.push(resolve));
        },
        close: () => rl.close(),
    };
}

async function fetchJson(port, route) {
    try {
        const res = await fetch(`http://127.0.0.1:${port}${route}`, { signal: AbortSignal.timeout(15000) });
        return res.ok ? await res.json() : null;
    } catch {
        return null;
    }
}

async function setupModels(port) {
    const snapshotDir = path.join(BUNDLED_PROXY, 'src');
    const live = await fetchJson(port, '/v1/models');
    const catalog = live
        ? live.data.map((m) => m.id)
        : JSON.parse(fs.readFileSync(path.join(snapshotDir, 'models.json'), 'utf8')).map((m) => m.id);
    const routeInfo = await fetchJson(port, '/routes');
    const routes = routeInfo?.routes ?? JSON.parse(fs.readFileSync(path.join(snapshotDir, 'routes.json'), 'utf8'));
    const policyFile = getPolicyFile();
    // No saved file yet: start from the bundled default policy.
    const current = JSON.parse(fs.readFileSync(fs.existsSync(policyFile) ? policyFile : path.join(snapshotDir, 'policy.json'), 'utf8'));

    console.log('Model allowlist setup');
    console.log(`  catalog: ${catalog.length} models (${live ? `live from proxy on port ${port}` : 'bundled snapshot; start clap first for the live list'})`);
    console.log(`  saving to: ${policyFile}`);
    if (process.env.CCP_ALLOWED_MODELS !== undefined || process.env.CCP_REROUTE_BLOCKED_TO !== undefined)
        console.log('  note: CCP_ALLOWED_MODELS / CCP_REROUTE_BLOCKED_TO are set in your environment and override this file');

    const prompt = createPrompter();
    try {
        // Step 1: allowed models
        const routeTargets = [...new Set(Object.values(routes).filter(Boolean))];
        const defAllowed = (current.allowed?.length ? current.allowed : routeTargets).join(',');
        console.log('\nStep 1/3: which upstream models may be used?');
        console.log('  Comma-separated ids or globs (e.g. swe-2-high,swe-1-*). "all" removes the limit.');
        console.log('  Type ? to list every model, or ? <text> to search.');
        let allowed;
        for (;;) {
            const ans = (await prompt.ask(`  Allowed [${defAllowed}]: `))?.trim();
            if (ans?.startsWith('?')) {
                const q = ans.slice(1).trim();
                const hits = catalog.filter((id) => id.includes(q));
                console.log(hits.length ? hits.map((id) => `    ${id}`).join('\n') : '    (no match)');
                continue;
            }
            if (ans === null && !defAllowed) { allowed = []; break; }
            const raw = ans || defAllowed;
            if (/^(all|\*)$/i.test(raw)) { allowed = []; break; }
            const entries = raw.split(',').map((e) => e.trim()).filter(Boolean);
            const unknown = entries.filter((e) => !catalog.some((id) => globRe(e).test(id)));
            if (!unknown.length) { allowed = entries; break; }
            console.log(`  Not in the catalog: ${unknown.join(', ')}. Try again (? <text> to search).`);
            if (ans === null) throw new Error('no valid allowlist given');
        }

        // Step 2: where blocked requests go
        let reroute = null;
        if (allowed.length) {
            const isOk = (id) => allowed.some((e) => globRe(e).test(id));
            console.log('\n  With this list, the current routes behave like this:');
            for (const [from, to] of Object.entries(routes))
                if (to) console.log(`    ${from.padEnd(18)} -> ${to.padEnd(14)} ${isOk(to) ? 'allowed' : 'BLOCKED'}`);
            const choices = catalog.filter(isOk).slice(0, 20);
            console.log('\nStep 2/3: where should requests for blocked models go?');
            console.log('  0) reject them with an error');
            choices.forEach((id, i) => console.log(`  ${i + 1}) ${id}`));
            const prev = current.reroute_blocked_to;
            const def = prev === null ? '0' : String(Math.max(choices.indexOf(prev), 0) + 1);
            for (;;) {
                const ans = (await prompt.ask(`  Choice [${def}]: `))?.trim() || def;
                const n = Number(ans);
                if (n === 0) break;
                if (Number.isInteger(n) && n >= 1 && n <= choices.length) { reroute = choices[n - 1]; break; }
                if (isOk(ans)) { reroute = ans; break; }
                console.log(`  Enter 0-${choices.length} or an allowed model id.`);
            }
        }

        fs.mkdirSync(path.dirname(policyFile), { recursive: true });
        fs.writeFileSync(policyFile, JSON.stringify({ allowed, reroute_blocked_to: reroute }, null, 2) + '\n');
        console.log(`\nSaved ${policyFile}`);
        console.log(allowed.length
            ? `  allowed: ${allowed.join(', ')}\n  blocked -> ${reroute ?? 'rejected with an error'}`
            : '  allowed: all models');

        // Step 3: apply
        console.log('\nStep 3/3: apply');
        if (!(await isProxyHealthy(port))) {
            console.log(`  No proxy running on port ${port}; the next clap run starts one with this list.`);
            return;
        }
        const ans = (await prompt.ask(`  Restart the proxy on port ${port} now so this takes effect? [Y/n]: `))?.trim();
        if (/^n/i.test(ans || '')) {
            console.log('  Not restarted. The running proxy keeps its old list until it restarts.');
            return;
        }
        restartProxy(port);
        await startProxy(resolveProxyDir(), port);
        console.log('  Check it with: clap --routes');
    } finally {
        prompt.close();
    }
}

// ---- clap --doctor ----

const CLAUDE_INSTALL = process.platform === 'win32'
    ? 'powershell -NoProfile -Command "irm https://claude.ai/install.ps1 | iex"'
    : 'curl -fsSL https://claude.ai/install.sh | bash';

function commandVersion(cmd) {
    try {
        return execSync(`${cmd} --version`, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim().split('\n')[0];
    } catch {
        return null;
    }
}

// Returns the exit code: 0 when everything clap needs is there.
async function doctor() {
    const ok = (msg) => console.log(`  ok    ${msg}`);
    const bad = (msg) => console.log(`  MISS  ${msg}`);
    let problems = 0;
    console.log('clap doctor\n');

    const [maj, min] = process.versions.node.split('.').map(Number);
    if (maj > 18 || (maj === 18 && min >= 19)) ok(`node ${process.versions.node}`);
    else { bad(`node ${process.versions.node}: 18.19 or newer is required`); problems++; }

    const git = commandVersion('git');
    if (git) ok(git);
    else console.log('  --    git not found (only needed for clap --update)');

    try {
        const { loadApiKey } = await import(path.join(BUNDLED_PROXY, 'src', 'config.js'));
        loadApiKey();
        ok(`API key (${process.env.CCP_API_KEY ? 'CCP_API_KEY / COGNITION_API_KEY' : 'Devin credentials.toml'})`);
    } catch (error) {
        bad(`API key: ${error.message}`);
        console.log('        Set COGNITION_API_KEY in your environment or in .env.global, or log in with the Devin CLI.');
        problems++;
    }

    const prompt = createPrompter();
    try {
        const claude = commandVersion('claude');
        if (claude) {
            ok(`claude ${claude}`);
            const ans = (await prompt.ask('\n  Update claude to the latest version? [y/N]: '))?.trim();
            if (/^y/i.test(ans || '')) execSync('claude update', { stdio: 'inherit' });
        } else {
            bad('claude (Claude Code CLI) not found');
            console.log(`        Installer: ${CLAUDE_INSTALL}`);
            const ans = (await prompt.ask('\n  Install it now? [Y/n]: '))?.trim();
            if (/^n/i.test(ans || '')) problems++;
            else {
                try {
                    execSync(CLAUDE_INSTALL, { stdio: 'inherit', shell: process.platform === 'win32' ? undefined : '/bin/bash' });
                } catch {}
                if (commandVersion('claude')) ok('claude installed');
                else {
                    bad('claude is still not on PATH (open a new terminal, or add ~/.local/bin to PATH)');
                    problems++;
                }
            }
        }
    } finally {
        prompt.close();
    }

    console.log(problems ? `\n${problems} problem(s) left.` : '\nAll set: run clap.');
    return problems ? 1 : 0;
}

// Stop whatever proxy listens on `port` (our own: it must answer /health)
function restartProxy(port) {
    const pids = execSync(`lsof -ti tcp:${port} -sTCP:LISTEN`, { encoding: 'utf8' }).trim().split('\n').filter(Boolean);
    for (const pid of pids) process.kill(Number(pid));
    for (let i = 0; i < 50 && isPortInUse(port); i++) execSync('sleep 0.1');
}

// Run main
main().catch(error => {
    console.error(`Error: ${error.message}`);
    process.exit(1);
});
